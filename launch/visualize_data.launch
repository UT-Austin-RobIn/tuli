<launch>
  <!-- Runtime arguments -->
  <arg name="bag_file" default="$(env HOME)/infants/data/smoke_test/20260302_235500_smoke.bag"/>
  <arg name="rviz_config" default="$(env HOME)/infants/launch/rviz_pointcloud.rviz"/>
  <arg name="fixed_frame" default="cam_L_color_optical_frame"/>
  <arg name="loop_bag" default="true"/>
  <arg name="bag_delay" default="1.0"/>

  <param name="/use_sim_time" value="true"/>

  <!-- === 1. RGB-D to PointCloud2 === -->
  <node name="depth_to_pointcloud"
        pkg="rosout"
        type="rosout"
        output="screen"
        launch-prefix="$(env HOME)/infants/infants/scripts/run_depth_to_pointcloud.sh">
    <param name="subsample" value="2"/>
  </node>

  <!-- === 2. Rosbag Playback === -->
  <node pkg="rosbag" type="play" name="bag_player"
        args="--clock --loop --delay=$(arg bag_delay) $(arg bag_file)"
        if="$(arg loop_bag)"
        required="false"/>
  <node pkg="rosbag" type="play" name="bag_player_once"
        args="--clock --delay=$(arg bag_delay) $(arg bag_file)"
        unless="$(arg loop_bag)"
        required="false"/>

  <!-- === 3. RViz Visualization === -->
  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(arg rviz_config)"
        required="true">
    <env name="ROS_NAMESPACE" value="/"/>
  </node>
</launch>
