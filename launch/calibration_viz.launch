<launch>
  <!--
    Calibration sanity-check viewer.

    Run inside a ROS1 environment, from anywhere:
      roslaunch /abs/path/to/calibration_viz.launch \
        repo_root:=/abs/path/to/stereo-calib \
        cam_bag:=/abs/path/to/trial_ros.bag \
        calib_dir:=/abs/path/to/calibration_results_parent \
        qtm_xml:=/abs/path/to/qualisys_calibration.txt \
        world_frame:=qualisys_ref \
        mocap_anchor_L:=31039 \
        mocap_anchor_R:=31041

    This launch file can run in two modes:
      1. Point-cloud-only (default): plays one camera bag and renders the 3
         point clouds with the calibration TF tree.
      2. Point-cloud + mocap marker: additionally plays a mocap bag and
         republishes /marker_1 into RViz.
  -->

  <arg name="repo_root"      default="$(env HOME)/Desktop/stereo-calib"/>
  <arg name="cam_bag"        default="$(arg repo_root)/calib_data/cam_only.bag"/>
  <arg name="calib_dir"      default="$(arg repo_root)/calib_data"/>
  <arg name="qtm_xml"        default="$(arg calib_dir)/mocap_calib_0415.txt"/>
  <arg name="calib_L_path"   default="$(arg calib_dir)/calib_qualisys_cam_L.json"/>
  <arg name="calib_R_path"   default="$(arg calib_dir)/calib_qualisys_cam_R.json"/>
  <arg name="calib_LM_path"  default="$(arg calib_dir)/callib_calib_L_cam_M.json"/>
  <arg name="mocap_bag"      default=""/>
  <arg name="play_mocap_bag" default="false"/>
  <arg name="show_mocap_marker" default="false"/>
  <arg name="world_frame"    default="qualisys_ref"/>
  <arg name="mocap_anchor_L" default="31039"/>
  <arg name="mocap_anchor_R" default="31041"/>
  <arg name="rviz"           default="true"/>
  <arg name="rate"           default="1.0"/>

  <param name="use_sim_time" value="true"/>

  <!-- Replay the camera bag on /clock. -->
  <node pkg="rosbag" type="play" name="rosbag_play"
        args="--clock --rate=$(arg rate) $(arg cam_bag)"
        output="screen" required="true"/>

  <!-- Optionally replay a separate mocap bag on the same /clock timeline. -->
  <node if="$(arg play_mocap_bag)" pkg="rosbag" type="play" name="rosbag_play_mocap"
        args="--clock --rate=$(arg rate) $(arg mocap_bag)"
        output="screen"/>

  <!-- Calibration TF tree: world to qualisys_ref to {cam_L, cam_R}; cam_L to cam_M. -->
  <node name="calib_tf_publisher"
        pkg="stereo_calib" type="calib_tf_publisher.py"
        output="screen">
    <param name="calib_dir"       value="$(arg calib_dir)"/>
    <param name="qtm_xml"         value="$(arg qtm_xml)"/>
    <param name="calib_L_path"    value="$(arg calib_L_path)"/>
    <param name="calib_R_path"    value="$(arg calib_R_path)"/>
    <param name="calib_LM_path"   value="$(arg calib_LM_path)"/>
    <param name="world_frame"    value="$(arg world_frame)"/>
    <param name="mocap_anchor_L" value="$(arg mocap_anchor_L)"/>
    <param name="mocap_anchor_R" value="$(arg mocap_anchor_R)"/>
  </node>

  <!--
    One nodelet manager + xyzrgb point cloud per camera. The nodelet's output
    point cloud's frame_id inherits from the depth Image header, which is
    cam_<X>_color_optical_frame in these bags - the same frame our TF publisher
    targets, so RViz can render all three clouds in `world_frame` without aliases.
  -->
  <group ns="cam_L">
    <node pkg="nodelet" type="nodelet" name="nodelet_manager" args="manager"/>
    <node pkg="nodelet" type="nodelet" name="cloud_xyzrgb"
          args="load depth_image_proc/point_cloud_xyzrgb nodelet_manager">
      <remap from="rgb/image_rect_color"        to="color/image_raw"/>
      <remap from="rgb/camera_info"             to="color/camera_info"/>
      <remap from="depth_registered/image_rect" to="aligned_depth_to_color/image_raw"/>
      <remap from="depth_registered/points"     to="points"/>
      <param name="queue_size" value="20"/>
    </node>
  </group>

  <group ns="cam_M">
    <node pkg="nodelet" type="nodelet" name="nodelet_manager" args="manager"/>
    <node pkg="nodelet" type="nodelet" name="cloud_xyzrgb"
          args="load depth_image_proc/point_cloud_xyzrgb nodelet_manager">
      <remap from="rgb/image_rect_color"        to="color/image_raw"/>
      <remap from="rgb/camera_info"             to="color/camera_info"/>
      <remap from="depth_registered/image_rect" to="aligned_depth_to_color/image_raw"/>
      <remap from="depth_registered/points"     to="points"/>
      <param name="queue_size" value="20"/>
    </node>
  </group>

  <group ns="cam_R">
    <node pkg="nodelet" type="nodelet" name="nodelet_manager" args="manager"/>
    <node pkg="nodelet" type="nodelet" name="cloud_xyzrgb"
          args="load depth_image_proc/point_cloud_xyzrgb nodelet_manager">
      <remap from="rgb/image_rect_color"        to="color/image_raw"/>
      <remap from="rgb/camera_info"             to="color/camera_info"/>
      <remap from="depth_registered/image_rect" to="aligned_depth_to_color/image_raw"/>
      <remap from="depth_registered/points"     to="points"/>
      <param name="queue_size" value="20"/>
    </node>
  </group>

  <!-- Optional mocap marker overlay for a separately played marker bag. -->
  <node if="$(arg show_mocap_marker)" name="mocap_marker_publisher"
        pkg="stereo_calib" type="mocap_marker_publisher.py"
        output="screen">
    <param name="input_topic"   value="/marker_1"/>
    <param name="output_topic"  value="/mocap_markers"/>
    <param name="frame_id"      value="qualisys_ref"/>
    <param name="sphere_radius" value="0.03"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(arg repo_root)/config/calibration_viz.rviz"
        output="screen"/>
</launch>
